{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:page(spec|lab|validate|adopt|generate|examples|docs|platform|connect|audit|compare|about)",
      "destination": "/:page/",
      "permanent": true
    }
  ],
  "functions": {
    "api/platform.ts": {
      "maxDuration": 60,
      "includeFiles": "docs/{SPEC,SITE-PROFILE,PUBLICATION}.md"
    }
  },
  "rewrites": [
    {
      "source": "/agentic.json",
      "destination": "/api/platform"
    },
    {
      "source": "/agentic.txt",
      "destination": "/api/platform"
    },
    {
      "source": "/api/platform/:path*",
      "destination": "/api/platform"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/platform"
    },
    {
      "source": "/mcp",
      "destination": "/api/platform"
    },
    {
      "source": "/a2a",
      "destination": "/api/platform"
    },
    {
      "source": "/.well-known/agent-card.json",
      "destination": "/api/platform"
    },
    {
      "source": "/.well-known/agent-configuration",
      "destination": "/api/platform"
    }
  ],
  "crons": [
    {
      "path": "/api/platform/cleanup",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/platform/",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Link",
          "value": "</platform/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/connect/",
      "headers": [
        {
          "key": "Link",
          "value": "</connect/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/spec/",
      "headers": [
        {
          "key": "Link",
          "value": "</spec/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/lab/",
      "headers": [
        {
          "key": "Link",
          "value": "</lab/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/validate/",
      "headers": [
        {
          "key": "Link",
          "value": "</validate/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/adopt/",
      "headers": [
        {
          "key": "Link",
          "value": "</adopt/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/generate/",
      "headers": [
        {
          "key": "Link",
          "value": "</generate/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/examples/",
      "headers": [
        {
          "key": "Link",
          "value": "</examples/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/docs/",
      "headers": [
        {
          "key": "Link",
          "value": "</docs/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/schemas/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/audit/",
      "headers": [
        {
          "key": "Link",
          "value": "</audit/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/compare/",
      "headers": [
        {
          "key": "Link",
          "value": "</compare/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    },
    {
      "source": "/about/",
      "headers": [
        {
          "key": "Link",
          "value": "</about/index.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\""
        }
      ]
    }
  ]
}
